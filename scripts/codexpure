#!/usr/bin/env bash
set -euo pipefail

# Run Codex with private SQLite state while retaining the operator's current
# authentication, configuration, and read-mostly extension catalog.
umask 077

base_codex="${CODEX_PURE_BASE_CODEX:-/home/tibor/.local/bin/codex}"
source_codex_home="${CODEX_PURE_SOURCE_HOME:-${HOME}/.codex}"
state_root="${CODEX_PURE_STATE_ROOT:-${HOME}/.local/state/codexpure}"
instance_id="${CODEX_PURE_INSTANCE:-}"
explicit_home="${CODEX_PURE_HOME:-}"
runtime_wait_seconds="${CODEX_PURE_RUNTIME_WAIT_SECONDS:-0}"

fail() {
  printf 'codexpure: %s\n' "$1" >&2
  exit 1
}

busy() {
  printf 'codexpure: %s\n' "$1" >&2
  exit 75
}

ensure_private_dir() {
  local path="$1"

  if [ -L "$path" ]; then
    fail "refusing symlinked state directory: $path"
  fi
  mkdir -p -- "$path"
  if [ "$(stat -c '%u' -- "$path")" != "$(id -u)" ]; then
    fail "state directory is not owned by the current user: $path"
  fi
  chmod 0700 -- "$path"
}

atomic_copy_private() {
  local name="$1"
  local source_path="${source_codex_home}/${name}"
  local target_path="${pure_home}/${name}"
  local temporary_path="${pure_home}/.${name}.tmp.$$"

  [ -e "$source_path" ] || return 0
  if [ ! -f "$source_path" ] || [ -L "$source_path" ]; then
    fail "shared bootstrap file is not a regular file: $source_path"
  fi
  install -m 0600 -- "$source_path" "$temporary_path"
  mv -fT -- "$temporary_path" "$target_path"
}

link_shared_directory() {
  local name="$1"
  local source_path="${source_codex_home}/${name}"
  local target_path="${pure_home}/${name}"
  local observed_target=""

  [ -d "$source_path" ] || return 0
  if [ -L "$target_path" ]; then
    observed_target="$(readlink -- "$target_path")"
    if [ "$observed_target" != "$source_path" ]; then
      fail "shared directory link has an unexpected target: $target_path"
    fi
    return 0
  fi
  if [ -e "$target_path" ]; then
    fail "shared directory target already exists and is not a symlink: $target_path"
  fi
  ln -s -- "$source_path" "$target_path"
}

if [ ! -x "$base_codex" ]; then
  fail "base Codex launcher is not executable: $base_codex"
fi
if [ ! -d "$source_codex_home" ] || [ -L "$source_codex_home" ]; then
  fail "canonical Codex home is unavailable or symlinked: $source_codex_home"
fi
source_codex_home="$(realpath -e -- "$source_codex_home")"

if [ -z "$instance_id" ]; then
  terminal_path="$(tty 2>/dev/null || true)"
  if [ -n "$terminal_path" ] && [ "$terminal_path" != "not a tty" ]; then
    instance_id="${terminal_path#/dev/}"
    instance_id="${instance_id//\//-}"
  else
    # Non-interactive siblings can share PPID; BASHPID remains process-unique.
    instance_id="process-${PPID}-${BASHPID}"
  fi
fi
if [[ ! "$instance_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then
  fail "CODEX_PURE_INSTANCE must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}"
fi

if [ -n "$explicit_home" ]; then
  pure_home="$explicit_home"
else
  pure_home="${state_root}/instances/${instance_id}"
fi
case "$pure_home" in
  /*) ;;
  *) fail "pure Codex home must be an absolute path: $pure_home" ;;
esac
pure_home="$(realpath -m -- "$pure_home")"
case "$pure_home" in
  "$source_codex_home"|"$source_codex_home"/*)
    fail "pure Codex home must be outside the canonical Codex home"
    ;;
esac
case "$runtime_wait_seconds" in
  ''|*[!0-9]*)
    fail "CODEX_PURE_RUNTIME_WAIT_SECONDS must be a non-negative integer"
    ;;
esac

ensure_private_dir "$state_root"
ensure_private_dir "${state_root}/instances"
ensure_private_dir "$pure_home"

exec 9>"${pure_home}/.bootstrap.lock"
if command -v flock >/dev/null 2>&1; then
  flock -w "${CODEX_PURE_BOOTSTRAP_WAIT_SECONDS:-30}" 9 || \
    fail "timed out waiting for the private-home bootstrap lock"
fi

for bootstrap_file in auth.json config.toml installation_id models_cache.json version.json; do
  atomic_copy_private "$bootstrap_file"
done
for shared_directory in skills plugins prompts rules; do
  link_shared_directory "$shared_directory"
done

if command -v flock >/dev/null 2>&1; then
  flock -u 9
fi
exec 9>&-

# Hold the lock through exec. A duplicate explicit/TTY instance fails before
# opening SQLite; no process is killed and no state file is removed.
exec 7>"${pure_home}/.runtime.lock"
if command -v flock >/dev/null 2>&1; then
  if [ "$runtime_wait_seconds" -eq 0 ]; then
    flock -n 7 || busy "private Codex instance is already active: ${instance_id}"
  else
    flock -w "$runtime_wait_seconds" 7 || \
      busy "timed out waiting for private Codex instance: ${instance_id}"
  fi
fi

export CODEX_HOME="$pure_home"
exec "$base_codex" \
  -c 'mcp_servers.vexp.enabled=false' \
  -c 'project_doc_max_bytes=0' \
  "$@"
