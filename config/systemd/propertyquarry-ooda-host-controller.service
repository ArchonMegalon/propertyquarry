[Unit]
Description=PropertyQuarry host-only OODA evaluate and stage controller
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/docker/property
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /docker/property/scripts/propertyquarry_ooda_host_controller.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/docker/property/_completion
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
