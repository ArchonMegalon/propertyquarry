{
  "name": "propertyquarry-android",
  "version": "1.1.0",
  "private": true,
  "description": "Isolated PropertyQuarry Android shell",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "test:web": "node --test test/*.test.mjs",
    "android:preview": "npm run sync && cd android && ./gradlew assemblePreview",
    "android:preview:container": "npm run sync && bash scripts/build-preview-container.sh",
    "android:release": "npm run sync && cd android && ./gradlew bundleRelease",
    "android:release:container": "npm run sync && bash scripts/build-release-container.sh",
    "android:release:readiness": "node scripts/verify-release-readiness.mjs",
    "android:upload-key:provision": "bash scripts/provision-upload-key.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
