EA_PROPERTY_SOURCE_LISTING_CACHE_BACKEND=auto
EA_PROPERTY_SOURCE_LISTING_CACHE_PATH=/docker/property/state/property_source_listing_cache.json
EA_PROPERTY_SOURCE_LISTING_CACHE_TTL_SECONDS=900
EA_PROPERTY_SOURCE_LISTING_CACHE_STALE_MAX_SECONDS=21600
# Full search-run payloads are compacted after 90 days by default. Terminal
# rows compact immediately; active payloads, per-principal rows, and each
# cleanup transaction are independently bounded.
EA_PROPERTY_SEARCH_RUN_RETENTION_SECONDS=7776000
EA_PROPERTY_SEARCH_RUN_MAX_PAYLOAD_BYTES=524288
EA_PROPERTY_SEARCH_RUN_MAX_ROWS_PER_PRINCIPAL=500
EA_PROPERTY_SEARCH_RETENTION_BATCH_SIZE=250
# Oversized generic observations must point at an external raw payload.
EA_OBSERVATION_MAX_PAYLOAD_BYTES=524288
EA_PROPERTY_MAP_PREVIEW_CACHE_MAX_ENTRIES=2048
EA_PROPERTY_MAP_PREVIEW_CACHE_MAX_BYTES=268435456
EA_ARTIFACT_MAX_BYTES=16777216
EA_ARTIFACTS_MIN_FREE_BYTES=10737418240
# Owner-only scheduled retention and read-only high-water defaults.
EA_RETENTION_BATCH_SIZE=500
EA_RETENTION_MAX_ROWS_PER_TABLE=10000
EA_RETENTION_LOCK_TIMEOUT_MS=2000
EA_RETENTION_STATEMENT_TIMEOUT_MS=30000
EA_RETENTION_JOURNAL_MAX_ROWS=1000
EA_DB_SIZE_WARN_MB=8192
EA_DB_SIZE_CRITICAL_MB=16384
EA_DB_TABLE_WARN_MB=4096
EA_DB_WAL_WARN_MB=2048
EA_DB_DEAD_TUPLE_WARN_PERCENT=20
EA_STORAGE_STATE_WARN_GB=15
EA_STORAGE_STATE_CRITICAL_GB=25
EA_STORAGE_VOLUME_WARN_GB=25
EA_STORAGE_BUILD_CACHE_WARN_GB=20
EA_PROPERTY_INVESTMENT_EXTERNAL_ALLOWED_HOSTS=
EA_PROPERTY_INVESTMENT_EXTERNAL_CACHE_PATH=/docker/property/state/property_investment_external_cache.json
# Absolute paths to short-lived signed release-control artifacts. The checkout
# cannot issue them and production execution remains blocked when they are empty.
PROPERTYQUARRY_RECOVERY_SIGNED_AUTHORIZATION=
PROPERTYQUARRY_ROLLBACK_SIGNED_AUTHORIZATION=
