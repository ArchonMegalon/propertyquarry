[Unit]
Description=PropertyQuarry single-host v2 release authority connection
Documentation=https://propertyquarry.com/
Requires=docker.service
Wants=network-online.target
After=propertyquarry-release-single-host-v2.socket docker.service network-online.target

[Service]
Type=exec
User=root
Group=root
UMask=0077
ExecStart=/usr/libexec/propertyquarry-release-control/propertyquarry-release-single-host-v2 serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
LoadCredentialEncrypted=github-api-token:/etc/propertyquarry-release-single-host-v2/github-api-token.cred
BindReadOnlyPaths=%d/github-api-token:/run/credentials/propertyquarry-release-single-host-v2.service/github-api-token
ReadOnlyPaths=/docker/property/state/runtime/propertyquarry_google_identity.env
ReadOnlyPaths=/docker/property/state/runtime/propertyquarry_registration_email.env
ReadOnlyPaths=/docker/property/state/runtime/propertyquarry_admission.env
ReadOnlyPaths=/docker/property/state/runtime/property_scene_video_shared.env
ReadOnlyPaths=/home/tibor/.local/share/propertyquarry-backup-keys/propertyquarry-predeploy-backup-v2.key
ReadWritePaths=/docker/property/.env
ReadWritePaths=/docker/property/state/runtime
ReadWritePaths=/var/lib/propertyquarry-release-single-host-v2
ReadWritePaths=/run/propertyquarry-release-single-host-v2
ReadWritePaths=/run/docker.sock
ReadWritePaths=/mnt/pcloud/propertyquarry/releases/backups/v2
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
IPAccounting=yes
PrivateUsers=no
PrivateNetwork=no
KillMode=mixed
TimeoutStartSec=315min
TimeoutStopSec=315min
Restart=no
LimitCORE=0
